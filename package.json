{
  "name": "retromancy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "predev:web": "npm run icons",
    "prebuild": "npm run icons",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node scripts/api.mjs",
    "dev:desktop": "concurrently -k -n api,web,desktop \"npm:dev:api\" \"npm:dev:web\" \"wait-on http://127.0.0.1:5173 && npm run electron:build && electron . --dev\"",
    "build:api": "cd api && go build -o bin/retromancy-api ./cmd/server",
    "electron:build": "tsc -p tsconfig.electron.json",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "build": "npm run build:api && tsc -b && vite build && npm run electron:build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:api": "cd api && go test -race ./...",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^39.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.0",
    "wait-on": "^9.0.0"
  }
}
